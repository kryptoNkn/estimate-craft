# Шаблон env для локальной разработки. Скопируй в `.env`, не коммить секреты.
# APP_ENV=production включает жёстче правила пароля. JWT_* — issuer/audience/TTL.

SERVER_HOST=127.0.0.1
SERVER_PORT=8001
APP_ENV=development
DATABASE_URL=postgres://auth_user:auth_password@localhost:5432/auth_db
# JWT_SECRET — свой ключ, не копируй example. Локально: openssl rand -base64 48
JWT_SECRET=local-dev-only-constructor-wm-jwt-secret-do-not-ship
JWT_ISSUER=constructor-wm-auth
JWT_AUDIENCE=constructor-wm-web
JWT_ACCESS_EXPIRES_IN_SECS=900
JWT_REFRESH_EXPIRES_IN_SECS=604800
PASSWORD_RESET_EXPIRES_IN_SECS=3600
SESSION_CLEANUP_INTERVAL_SECS=3600
CORS_ALLOWED_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
# За nginx/Traefik: TRUST_PROXY=true — лимит по последнему IP в X-Forwarded-For.
# Без флага заголовок игнорируется (клиент не подделает IP).
TRUST_PROXY=false
# SMTP. В development можно не задавать SMTP_HOST — ссылка сброса пойдёт в лог.
# В production (APP_ENV=production) SMTP_HOST и SMTP_FROM обязательны.
# SMTP_TLS=starttls|tls|none (465 → tls, иначе starttls). none — Mailpit/Mailhog.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Constructor WM <noreply@example.com>