# Шаблон env для локальной разработки. Скопируй в `.env`, не коммить секреты.
# APP_ENV=production включает жёстче правила пароля. JWT_* — issuer/audience/TTL.

SERVER_HOST=127.0.0.1
SERVER_PORT=8001
APP_ENV=development
DATABASE_URL=postgres://auth_user:auth_password@localhost:5432/auth_db
JWT_SECRET=dev-secret-change-in-production-min-32-chars
JWT_ISSUER=constructor-wm-auth
JWT_AUDIENCE=constructor-wm-web
JWT_ACCESS_EXPIRES_IN_SECS=900
JWT_REFRESH_EXPIRES_IN_SECS=604800
CORS_ALLOWED_ORIGIN=http://localhost:3000